# ESP-IDF build output
build/

# Managed components (pulled from dependencies.lock via idf_component.yml)
managed_components/

# Third-party deps. components/srtp (libsrtp, BSD) and components/esp-libopus
# (Opus, BSD) are VENDORED — committed as-is from the upstream reference
# firmware, licenses inside. deps/libpeer is fetched + patched by
# scripts/fetch_libpeer.sh. components/esp-protocols is only for the
# IDF_TARGET=linux host build (not used for the device).
components/esp-protocols/
deps/libpeer/

# Generated sdkconfig (sdkconfig.defaults is the tracked source of truth)
sdkconfig
sdkconfig.old

# Editor / OS cruft
*.swp
.DS_Store
