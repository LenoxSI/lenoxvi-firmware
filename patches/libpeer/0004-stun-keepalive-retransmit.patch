+/* LenoxVI 0004: resend an unanswered keepalive every N ms (0 = never,
+ * upstream behavior). */
+#ifndef CONFIG_STUN_KEEPALIVE_RETX
+#define CONFIG_STUN_KEEPALIVE_RETX 0
+#endif
+
 #ifndef CONFIG_STUN_KEEPALIVE_TIMEOUT
 #define CONFIG_STUN_KEEPALIVE_TIMEOUT 15000
 #endif
