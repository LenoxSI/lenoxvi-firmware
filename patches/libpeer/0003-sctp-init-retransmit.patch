# lenoxvi libpeer patch 0003 (2026-10-14): SCTP INIT retransmit (RFC 4960
# T1-init) — the lone upstream INIT is dropped by aiortc on ~60% of sessions
# (passive SCTP side + drops app data before its SCTP receiver registers).
diff --git a/src/peer_connection.c b/src/peer_connection.c
--- a/src/peer_connection.c
