+#define SCTP_INIT_RTO_MS 500
+#define SCTP_INIT_MAX_TRIES 20  /* 10 s — inside the node's 20 s DC watchdog */
+void sctp_tick(Sctp* sctp) {
+#if !CONFIG_USE_USRSCTP
+  if (sctp->connected || sctp->init_tries <= 0 || sctp->init_tries >= SCTP_INIT_MAX_TRIES) {
+    return;
+  }
+  sctp_lock();
+  if (!sctp->connected && sctp->init_tries > 0 && sctp->init_tries < SCTP_INIT_MAX_TRIES &&
+      (uint32_t)(ports_get_epoch_time() - sctp->init_sent_ms) >= SCTP_INIT_RTO_MS) {
+    LOGI("SCTP INIT retransmit #%d (no association yet)", sctp->init_tries);
+    sctp_send_init(sctp);
+    sctp->init_tries++;
+    sctp->init_sent_ms = ports_get_epoch_time();
+  }
+  sctp_unlock();
+#else
+  (void)sctp;
+#endif
+}
