+/* LenoxVI H2 wrappers: public entry points take the lock around the
+ * unchanged upstream bodies (no early-return unlock bookkeeping). */
+int sctp_outgoing_data(Sctp* sctp, char* buf, size_t len, SctpDataPpid ppid, uint16_t sid) {
+  sctp_lock();
+  int ret = sctp_outgoing_data_impl(sctp, buf, len, ppid, sid);
+  sctp_unlock();
+  return ret;
+}
+
+void sctp_incoming_data(Sctp* sctp, char* buf, size_t len) {
+  sctp_lock();
+  sctp_incoming_data_impl(sctp, buf, len);
+  sctp_unlock();
+}
+
+int sctp_create_association(Sctp* sctp, DtlsSrtp* dtls_srtp) {
+  sctp_lock();
+  int ret = sctp_create_association_impl(sctp, dtls_srtp);
+  sctp_unlock();
+  return ret;
+}
