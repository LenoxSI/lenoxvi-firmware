+/* LenoxVI H2 (2026-10-14) — see sctp.h. */
+#if defined(ESP_PLATFORM)
+#include <freertos/FreeRTOS.h>
+#include <freertos/semphr.h>
+static StaticSemaphore_t s_sctp_lock_buf;
+static SemaphoreHandle_t s_sctp_lock = NULL;
+static portMUX_TYPE s_sctp_lock_init_mux = portMUX_INITIALIZER_UNLOCKED;
+void sctp_lock(void) {
+  if (s_sctp_lock == NULL) {  /* first use: create exactly once */
+    taskENTER_CRITICAL(&s_sctp_lock_init_mux);
+    if (s_sctp_lock == NULL) {
+      s_sctp_lock = xSemaphoreCreateRecursiveMutexStatic(&s_sctp_lock_buf);
+    }
+    taskEXIT_CRITICAL(&s_sctp_lock_init_mux);
+  }
+  xSemaphoreTakeRecursive(s_sctp_lock, portMAX_DELAY);
+}
+void sctp_unlock(void) { xSemaphoreGiveRecursive(s_sctp_lock); }
+#else
+/* Non-ESP builds (Linux examples): unchanged upstream behavior. */
+void sctp_lock(void) {}
+void sctp_unlock(void) {}
+#endif
