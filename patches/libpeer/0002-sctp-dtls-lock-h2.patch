+/* LenoxVI H2 (2026-10-14): ONE recursive lock serializing every touch of
+ * the shared SCTP/DTLS state — sctp->buf (outgoing build AND incoming
+ * SACK/response build share it; incoming memsets it), sctp->tsn, the
+ * outgoing stream sequences, and the mbedtls SSL context (read in the
+ * loop task, written from any app task; mbedtls contexts are NOT thread
+ * safe). Recursive: the incoming path re-enters sctp_outgoing_data for
+ * the DCEP ACK. Module-level (not in Sctp): PeerConnection memsets its
+ * Sctp, which would wipe a handle stored there. */
+void sctp_lock(void);
+void sctp_unlock(void);
+
 void sctp_incoming_data(Sctp* sctp, char* buf, size_t len);
 
 int sctp_outgoing_data(Sctp* sctp, char* buf, size_t len, SctpDataPpid ppid, uint16_t sid);
