CONFIG_IDF_TARGET="esp32s3"

# ESP Event Loop on Linux
CONFIG_ESP_EVENT_POST_FROM_ISR=n
CONFIG_ESP_EVENT_POST_FROM_IRAM_ISR=n

# Disable TLS verification
# Production needs to include specific cert chain you care about
CONFIG_ESP_TLS_INSECURE=y
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=y

# Enable DTLS-SRTP
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y

# TLS 1.3 stays OFF: the HTTPS clients (offer POST, OTA check + download)
# speak TLS 1.2, which the bot's server accepts, and every shipped image was
# built this way. An early OTA build turned 1.3 on after a -0x4290 handshake
# failure; it isn't needed. Turning it on also makes libpeer's DTLS offer 1.3,
# which only works with DTLS pinned to 1.2 (libpeer patch 0001).
# CONFIG_MBEDTLS_SSL_PROTO_TLS1_3 is not set

# mbedtls allocations from PSRAM (2026-09-19): with WiFi + WebRTC +
# audio DMA live, the largest contiguous INTERNAL free block is ~20KB —
# mbedtls_ssl_setup (16KB in-buffer + out + handshake) fails -0x7F00
# (ALLOC_FAILED) at every OTA check. PSRAM has 8MB free; mbedtls buffers
# in PSRAM cost latency, not correctness, and the OTA path is not
# latency-sensitive. DTLS/SRTP media buffers stay internal (libpeer
# manages its own).
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# libpeer requires large stack allocations
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# Defaults to partitions.csv
CONFIG_PARTITION_TABLE_CUSTOM=y

# XIAO ESP32-S3 ships 8MB flash; the partition table needs 7.8MB
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# Set highest CPU Freq
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y

# Watchdogs ON (M5, 1.2.25). They were disabled here since the
# upstream example; a node that hangs a core now reboots instead of sitting
# dead until someone power-cycles it. Panic = print + reboot (default), and
# the OTA rollback gate still catches a new image that loops.
#  - Task WDT: 20 s, watching BOTH cores' idle tasks (anything hogging a
#    core for 20 s). The longest legit CPU burst at boot is the DTLS RSA-1024
#    keygen with hardware MPI — well under a second.
#  - Interrupt WDT: 800 ms (IDF default 300) for hung ISRs/critical sections.
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=20
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=y
CONFIG_ESP_INT_WDT=y
CONFIG_ESP_INT_WDT_TIMEOUT_MS=800
CONFIG_ESP_INT_WDT_CHECK_CPU1=y

# Enable Compiler Optimization
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_DISABLE=y

CONFIG_CODEC_I2C_BACKWARD_COMPATIBLE=n

# OTA rollback (H1, 2026-10-13): the BOOTLOADER boots a fresh
# OTA image in PENDING_VERIFY; the app marks it valid only after the health
# gate (ota.cpp — first bot round-trip over the data channel). Any reboot
# before that rolls back to the previous image. This is a BOOTLOADER
# feature: OTA never replaces the bootloader (IDF 5.3), so each node needs
# ONE USB flash of the new bootloader before rollback is live. Anti-rollback
# (security versions) stays off.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
